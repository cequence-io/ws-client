def init (p : Plan) : Config :=
  Config.mk (Sig.Eval p) [] [] []

def finish (sig : Sig) (parents : List Parent) (log : List Ev) : Option Config :=
  match parents with
  | [] =>
      none
  | (Parent.mk pf after) :: ps =>
      some (Config.mk (afterHookSig after sig) pf ps log)

def evalStep (p : Plan) (frames : List Frame) (parents : List Parent) (log : List Ev) : Config :=
  match p with
  | Plan.Value _ v =>
      Config.mk (Sig.OkS v) frames parents log
  | Plan.Fail _ t =>
      Config.mk (Sig.ErrS t) frames parents log
  | Plan.Defer q =>
      Config.mk (Sig.Eval q) frames parents log
  | Plan.DeferThrow t =>
      Config.mk (Sig.ErrS t) frames parents log
  | Plan.Gate =>
      Config.mk Sig.StopS frames parents log
  | Plan.MapAdd up n =>
      Config.mk (Sig.Eval up) ((Frame.FMapAdd n) :: frames) parents log
  | Plan.MapThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FMapThrow t) :: frames) parents log
  | Plan.FlatInc up n =>
      Config.mk (Sig.Eval up) ((Frame.FFlatInc n) :: frames) parents log
  | Plan.FlatThen up q =>
      Config.mk (Sig.Eval up) ((Frame.FFlatThen q) :: frames) parents log
  | Plan.FlatThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FFlatThrow t) :: frames) parents log
  | Plan.MapError up =>
      Config.mk (Sig.Eval up) (Frame.FMapError :: frames) parents log
  | Plan.MapErrorThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FMapErrorThrow t) :: frames) parents log
  | Plan.RecoverTo up n =>
      Config.mk (Sig.Eval up) ((Frame.FRecoverTo n) :: frames) parents log
  | Plan.RecoverUndefined up =>
      Config.mk (Sig.Eval up) (Frame.FRecoverUndefined :: frames) parents log
  | Plan.RecoverThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FRecoverThrow t) :: frames) parents log
  | Plan.RecoverWith up q =>
      Config.mk (Sig.Eval up) ((Frame.FRecoverWith q) :: frames) parents log
  | Plan.TransformSwap up =>
      Config.mk (Sig.Eval up) (Frame.FTransformSwap :: frames) parents log
  | Plan.TransformWith up qo qe =>
      Config.mk (Sig.Eval up) ((Frame.FTransformWith qo qe) :: frames) parents log
  | Plan.TransformThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FTransformThrow t) :: frames) parents log
  | Plan.AttemptFold up =>
      Config.mk (Sig.Eval up) (Frame.FAttemptFold :: frames) parents log
  | Plan.GuardLog up id =>
      Config.mk (Sig.Eval up) ((Frame.FGuardLog id) :: frames) parents log
  | Plan.GuardFail up t =>
      Config.mk (Sig.Eval up) ((Frame.FGuardFail t) :: frames) parents log
  | Plan.GuardThrow up t =>
      Config.mk (Sig.Eval up) ((Frame.FGuardThrow t) :: frames) parents log
  | Plan.GuardRun up q =>
      Config.mk (Sig.Eval up) ((Frame.FGuardRun q) :: frames) parents log
  | Plan.Timeout up =>
      Config.mk (Sig.Eval up) frames parents log
  | Plan.Delay up =>
      Config.mk (Sig.Eval up) frames parents log

def onStop (f : Frame) (rest : List Frame) (parents : List Parent) (log : List Ev) : Config :=
  match f with
  | Frame.FGuardLog id =>
      hookLog id Term.Cancelled Sig.StopS rest parents log
  | Frame.FGuardFail t =>
      hookChild (Plan.Fail Kind.Plain t) Sig.StopS rest parents log
  | Frame.FGuardThrow t =>
      hookThrown t Sig.StopS rest parents log
  | Frame.FGuardRun q =>
      hookChild q Sig.StopS rest parents log
  | _ =>
      Config.mk Sig.StopS rest parents log

def step (c : Config) : Option Config :=
  match c with
  | Config.mk sig frames parents log =>
      (match sig with
      | Sig.Eval p =>
          some (evalStep p frames parents log)
      | Sig.OkS v =>
          (match frames with
          | [] =>
              finish sig parents log
          | f :: rest =>
              some (onOk v f rest parents log))
      | Sig.ErrS t =>
          (match frames with
          | [] =>
              finish sig parents log
          | f :: rest =>
              some (onErr t f rest parents log))
      | Sig.StopS =>
          (match frames with
          | [] =>
              finish sig parents log
          | f :: rest =>
              some (onStop f rest parents log)))

def result (c : Config) : Obs :=
  match c.sig with
  | Sig.OkS v =>
      Obs.mk (Res.ROk v) c.log
  | Sig.ErrS t =>
      Obs.mk (Res.RErr t) c.log
  | Sig.StopS =>
      Obs.mk Res.RCancelled c.log
  | Sig.Eval _ =>
      Obs.mk Res.RCancelled c.log

