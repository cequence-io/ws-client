      | Sig.OkS _ =>
          Sig.ErrS t
      | _ =>
          after)
  | _ =>
      after

def hookThrown (t : Int) (after : Sig) (rest : List Frame) (parents : List Parent) (log : List Ev) : Config :=
  Config.mk (afterHookSig after (Sig.ErrS t)) rest parents log

