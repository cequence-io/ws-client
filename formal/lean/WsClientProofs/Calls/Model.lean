def termOf (r : Res) : Term :=
  match r with
  | Res.ROk _ =>
      Term.Completed
  | Res.RErr t =>
      Term.Failed t
  | Res.RCancelled =>
      Term.Cancelled

def afterHook (res : Res) (hook : Res) : Res :=
  match res with
  | Res.RErr e =>
      Res.RErr e
  | Res.RCancelled =>
      Res.RCancelled
  | Res.ROk v =>
      (match hook with
      | Res.RErr t =>
          Res.RErr t
      | _ =>
          Res.ROk v)

def sequence (log : List Ev) (next : Obs) : Obs :=
  Obs.mk next.res (log ++ next.log)

def guarded (up : Obs) (hook : Obs) : Obs :=
  Obs.mk (afterHook up.res hook.res) (up.log ++ hook.log)

